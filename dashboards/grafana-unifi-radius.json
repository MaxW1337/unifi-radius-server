{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Übersicht & Server Status",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [{ "expr": "unifi_radius_uptime_seconds", "legendFormat": "Uptime", "refId": "A" }],
      "title": "Server Uptime",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "sum(radius_requests_total)", "legendFormat": "Gesamt", "refId": "A" }],
      "title": "RADIUS Requests Gesamt",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "radius_requests_total{code=\"Accept\"}", "legendFormat": "Accepts", "refId": "A" }],
      "title": "Access-Accepts",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "radius_requests_total{code=\"Reject\"}", "legendFormat": "Rejects", "refId": "A" }],
      "title": "Access-Rejects",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "100 * radius_cache_hits_total / (radius_cache_hits_total + radius_cache_misses_total > 0 or 1)",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ],
      "title": "RAM Cache Hit-Rate",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "radius_clients_total{status=\"active\"}", "legendFormat": "Aktive Clients", "refId": "A" }],
      "title": "Aktive Clients",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "RADIUS Traffic & Performance",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "rate(radius_requests_total{code=\"Accept\"}[1m])", "legendFormat": "Accepts/sec", "refId": "A" },
        { "expr": "rate(radius_requests_total{code=\"Reject\"}[1m])", "legendFormat": "Rejects/sec", "refId": "B" }
      ],
      "title": "RADIUS Request Rate (req/sec)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "rate(radius_auth_methods_total{method=\"mab\"}[1m])", "legendFormat": "MAB (MAC)", "refId": "A" },
        { "expr": "rate(radius_auth_methods_total{method=\"eap-tls\"}[1m])", "legendFormat": "EAP-TLS (Cert)", "refId": "B" },
        { "expr": "rate(radius_auth_methods_total{method=\"pap\"}[1m])", "legendFormat": "PAP (User/Pass)", "refId": "C" }
      ],
      "title": "Authentifizierungsmethoden Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Latenz & UniFi Controller Sync",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(radius_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latenz",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(radius_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p90 Latenz",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(radius_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Median) Latenz",
          "refId": "C"
        }
      ],
      "title": "RADIUS Processing Latency (Quantiles)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 10,
      "targets": [
        { "expr": "unifi_sync_duration_seconds", "legendFormat": "Sync Dauer", "refId": "A" }
      ],
      "title": "UniFi Sync Dauer",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["unifi", "radius", "monitoring"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "UniFi RADIUS Server - Dashboard",
  "uid": "unifi-radius-metrics",
  "version": 1
}

